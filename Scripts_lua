local function weaponName(char)
    local tool=char:FindFirstChildOfClass('Tool')
    if tool then return tool.Name end
    for _,key in ipairs({'EquippedWeapon','WeaponName','CurrentWeapon'}) do
        local value=char:GetAttribute(key)
        if type(value)=='string' and value~='' then return value end
        local field=char:FindFirstChild(key)
        if field and field:IsA('StringValue') and field.Value~='' then return field.Value end
    end
    return '—'
end
