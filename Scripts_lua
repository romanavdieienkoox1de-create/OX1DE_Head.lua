-- Resource detection is heuristic; no game-specific object names are known.
local CollectionService = game:GetService('CollectionService')
local resourceKinds = {
    cupboard = {title='Шкаф', color=Color3.fromRGB(197, 130, 255)},
    stone = {title='Камень', color=Color3.fromRGB(200, 205, 218)},
    nitrate = {title='Сера', color=Color3.fromRGB(255, 255, 255)},
    metal = {title='Металл', color=Color3.fromRGB(255, 216, 70)},
}
local aliases = {
    stone={'stone','stoneore','stonenode','rock','rocknode','камень'},
    nitrate={'nitrate','nitrateore','nitratenode','saltpeter','saltpetre','селитра'},
    metal={'metal','metalore','metalnode','iron','ironore','металл','метал'},
}
local function identifyName(value)
    if type(value) ~= 'string' then return end
    local normalized = value:gsub('(%l)(%u)', '%1 %2'):lower()
    for kind, words in pairs(aliases) do
        for _, word in ipairs(words) do
            if normalized == word then return kind end
            for token in normalized:gmatch('[^%s_%-%d%.]+') do
                if token == word then return kind end
            end
        end
    end
end
local function identifyResource(object)
    if object.Name == 'Flag' and object.Parent
        and object.Parent.Name == 'PlacedDeployables' then return 'cupboard' end
    -- Typed metadata takes precedence over a generic model name.
    for _, key in ipairs({'ResourceType','OreType','Resource','NodeType'}) do
        local kind = identifyName(object:GetAttribute(key))
        if kind then return kind end
    end
    for _, tag in ipairs(CollectionService:GetTags(object)) do
        local kind = identifyName(tag)
        if kind and not (kind == 'stone' and tag:lower() == 'rock') then return kind end
    end
    local kind = identifyName(object.Name)
    if kind ~= 'stone' then return kind end
    -- A generic Rock/Stone name also occurs on decorative scenery.
    local name = object.Name:gsub('(%l)(%u)', '%1 %2'):lower()
    if name:find('ore', 1, true) or name:find('node', 1, true)
        or name:find('resource', 1, true) then
        return kind
    end
    local ancestor = object.Parent
    for _ = 1, 4 do
        if not ancestor or ancestor == workspace then break end
        local category = ancestor.Name:lower()
        if category == 'resources' or category == 'resource nodes'
            or category == 'resourcenodes' or category == 'ores'
            or category == 'orenodes' or category == 'harvestables'
            or category == 'spawnedharvestables' then
            return kind
        end
        ancestor = ancestor.Parent
    end
    return nil
end
local candidates, markers = {}, {}
local pending, pendingFirst, pendingLast = {}, 1, 0
local queued = setmetatable({}, {__mode='k'})
local function enqueue(object)
    if queued[object] or object == folder or object == gui then return end
    if object:IsDescendantOf(folder) or object:IsDescendantOf(gui) then return end
    queued[object] = true
    pendingLast = pendingLast + 1
    pending[pendingLast] = object
end
local function isCharacterOrTool(object)
    local ancestor = object
    while ancestor and ancestor ~= workspace do
        if ancestor:IsA('Tool') then return true end
        if ancestor:IsA('Model') and ancestor:FindFirstChildOfClass('Humanoid') then return true end
        ancestor = ancestor.Parent
    end
    return false
end
local function removeMarker(object)
    local marker = markers[object]
    if not marker then return end
    marker.highlight:Destroy()
    marker.tag:Destroy()
    markers[object] = nil
end
local function registerResource(object)
    if not object:IsA('Model') and not object:IsA('BasePart') then return end
    local kind = identifyResource(object)
    if not kind or isCharacterOrTool(object) then return end
    local part = object:IsA('BasePart') and object
        or object.PrimaryPart or object:FindFirstChildWhichIsA('BasePart', true)
    if part then candidates[object] = {kind=kind, part=part} end
end
-- Incremental traversal; never rescan the whole map each frame.
enqueue(workspace)
connect(workspace.DescendantAdded, function(object)
    enqueue(object)
    local parent = object.Parent
    if parent and parent:IsA('Model') then enqueue(parent) end
end)
connect(workspace.DescendantRemoving, function(object)
    candidates[object] = nil
    queued[object] = nil
    removeMarker(object)
end)
local function reserveMarkerSlot(counts, kind)
    local limit = kind == 'cupboard' and 8 or 24
    local count = counts[kind] or 0
    if count >= limit then return false end
    counts[kind] = count + 1
    return true
end
local resourceElapsed = 0
connect(RunService.Heartbeat, function(dt)
    for _ = 1, 120 do
        if pendingFirst > pendingLast then break end
        local object = pending[pendingFirst]
        pending[pendingFirst] = nil
        pendingFirst = pendingFirst + 1
        queued[object] = nil
        if object == workspace or object:IsDescendantOf(workspace) then
            if object ~= folder and not object:IsDescendantOf(folder) then
                registerResource(object)
                for _, child in ipairs(object:GetChildren()) do enqueue(child) end
            end
        end
    end
    if pendingFirst > pendingLast then
        pending, pendingFirst, pendingLast = {}, 1, 0
    end
    resourceElapsed = resourceElapsed + dt
    if resourceElapsed < 0.3 then return end
    resourceElapsed = 0
    local camera = workspace.CurrentCamera
    if not camera then return end
    local root = me.Character and me.Character:FindFirstChild('HumanoidRootPart')
    local origin = root and root.Position or camera.CFrame.Position
    local nearby = {}
    for object, entry in pairs(candidates) do
        if not object:IsDescendantOf(workspace) or not entry.part:IsDescendantOf(workspace) then
            candidates[object] = nil
            removeMarker(object)
        elseif cfg[entry.kind] then
            -- Avoid duplicate labels on ore models and their named children.
            local ancestor, nested = object.Parent, false
            while ancestor and ancestor ~= workspace do
                if candidates[ancestor] then nested=true; break end
                ancestor = ancestor.Parent
            end
            local distance = (entry.part.Position-origin).Magnitude*0.28
            local maxDistance=RESOURCE_DISTANCE
            if not nested and distance <= maxDistance then
                -- Keep the nearest markers independent of the camera angle.
                -- Roblox handles clipping; a model can be visible with its pivot offscreen.
                table.insert(nearby, {object=object, entry=entry, distance=distance})
            end
        end
    end
    table.sort(nearby, function(a,b) return a.distance < b.distance end)
    local selected = {}
    local countsByKind = {}
    for _, item in ipairs(nearby) do
        if not reserveMarkerSlot(countsByKind, item.entry.kind) then continue end
        local object, entry = item.object, item.entry
        selected[object] = true
        local marker = markers[object]
        local kind = resourceKinds[entry.kind]
        if not marker then
            local highlight = Instance.new('Highlight', folder)
            highlight.Adornee = object
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency = 0.72
            local tag = Instance.new('BillboardGui', gui)
            tag.Size = UDim2.fromOffset(180, 28)
            tag.StudsOffset = Vector3.new(0, 3, 0)
            tag.AlwaysOnTop = true
            local label = text(tag, '', 0, 28)
            label.TextStrokeTransparency = 0
            marker = {highlight=highlight, tag=tag, label=label}
            markers[object] = marker
        end
        marker.highlight.FillColor = kind.color
        marker.highlight.OutlineColor = kind.color
        marker.tag.Adornee = entry.part
        marker.label.TextColor3 = kind.color
        marker.label.Text = string.format('%s | %d м',kind.title,math.round(item.distance))
    end
