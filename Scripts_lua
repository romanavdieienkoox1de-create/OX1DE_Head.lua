local function slider(title, key, minimum, maximum, y)
    local label = text(panel, '', y, 24)
    local bar = Instance.new('TextButton', panel)
    bar.Position = UDim2.fromOffset(16, y+27)
    bar.Size = UDim2.new(1,-32,0,18)
    bar.Text = ''
    bar.BackgroundColor3 = Color3.fromRGB(65,67,78)
    round(bar)
    local fill = Instance.new('Frame', bar)
    fill.BorderSizePixel = 0
    fill.BackgroundColor3 = Color3.fromRGB(60,190,120)
    round(fill)
    local dragging, touch = false, nil
    local function refresh()
        label.Text = title .. ': ' .. cfg[key]
        fill.Size = UDim2.fromScale((cfg[key]-minimum)/(maximum-minimum),1)
    end
    local function set(x)
        if bar.AbsoluteSize.X <= 0 then return end
        local f = math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        cfg[key] = math.round(minimum+f*(maximum-minimum))
        refresh()
        updateCircle()
    end
    connect(bar.InputBegan,function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=true; set(i.Position.X)
        elseif i.UserInputType == Enum.UserInputType.Touch then touch=i; set(i.Position.X) end
    end)
    connect(UIS.InputChanged,function(i)
        if i == touch or (dragging and i.UserInputType == Enum.UserInputType.MouseMovement) then set(i.Position.X) end
    end)
    connect(UIS.InputEnded,function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end
        if i == touch then touch=nil end
    end)
    refresh()
end
