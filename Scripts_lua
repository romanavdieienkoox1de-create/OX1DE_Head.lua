if onScreen and pixels <= cfg.fov then
            table.insert(candidatesForAim,{head=head,pixels=pixels})
        end
    end
    table.sort(candidatesForAim,function(a,b) return a.pixels < b.pixels end)
    for _, candidate in ipairs(candidatesForAim) do
        if clearPath(camera.CFrame.Position,candidate.head) then return candidate.head end
    end
end
local touchHeld = false
local touchAimButton = Instance.new('TextButton',gui)
touchAimButton.AnchorPoint = Vector2.new(1,1)
