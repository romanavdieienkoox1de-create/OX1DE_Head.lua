local function targetPart(char)
    if cfg.target=='Head' then return char:FindFirstChild('Head') end
    return char:FindFirstChild('UpperTorso') or char:FindFirstChild('Torso') or char:FindFirstChild('HumanoidRootPart')
end
local function chooseTarget(camera)
    if cfg.aimDistance<=0 or cfg.fov<=0 then return end
    local ownRoot=me.Character and me.Character:FindFirstChild('HumanoidRootPart')
    local origin=ownRoot and ownRoot.Position or camera.CFrame.Position
    local center=camera.ViewportSize/2
    local choices={}
    for _,player in ipairs(Players:GetPlayers()) do
        if player==me then continue end
        local char=player.Character
        local part=char and targetPart(char)
        local hum=char and char:FindFirstChildOfClass('Humanoid')
        if not part or not hum or hum.Health<=0 then continue end
        local root=char:FindFirstChild('HumanoidRootPart') or part
        if (root.Position-origin).Magnitude*0.28>cfg.aimDistance then continue end
        local projected,onScreen=camera:WorldToViewportPoint(part.Position)
        local pixels=(Vector2.new(projected.X,projected.Y)-center).Magnitude
        if onScreen and pixels<=cfg.fov then table.insert(choices,{part=part,pixels=pixels}) end
    end
    table.sort(choices,function(a,b) return a.pixels<b.pixels end)
    for _,choice in ipairs(choices) do
        if not cfg.walls or clearPath(camera.CFrame.Position,choice.part) then return choice.part end
    end
end
local selectedPart,nextSelection,lastTargetMode,lastWalls
nextSelection=0
local function aimStatus(value)
    if status.Text~=value then status.Text=value end
end
RunService:BindToRenderStep('OX1DECameraAim',Enum.RenderPriority.Last.Value+1,function()
    local camera=workspace.CurrentCamera
    if not alive or not camera or not cfg.aim or cfg.freecam or panel.Visible or UIS:GetFocusedTextBox() then
        selectedPart=nil
        nextSelection=0
        if cfg.freecam then aimStatus('Свободная камера: WASD, Q/E, Shift, ПКМ.')
        elseif cfg.aim then aimStatus('Aim включён — закрой меню для наведения.')
        else aimStatus('Aim выключен.') end
        return
    end
    local now=os.clock()
    if now>=nextSelection or lastTargetMode~=cfg.target or lastWalls~=cfg.walls then
        selectedPart=chooseTarget(camera)
        nextSelection=now+0.05
        lastTargetMode,lastWalls=cfg.target,cfg.walls
    end
    local part=selectedPart
    if not part or not part:IsDescendantOf(workspace) then aimStatus('Нет цели в FOV и пределах Aim Distance.');return end
    local hum=part.Parent:FindFirstChildOfClass('Humanoid')
    if not hum or hum.Health<=0 then selectedPart=nil;return end
    if cfg.walls and not clearPath(camera.CFrame.Position,part) then selectedPart=nil;nextSelection=0;return end
    local origin=camera.CFrame.Position
    if (part.Position-origin).Magnitude>0.001 then
        camera.CFrame=CFrame.lookAt(origin,part.Position)
        aimStatus(cfg.target..' • '..part.Parent.Name)
    end
end)
