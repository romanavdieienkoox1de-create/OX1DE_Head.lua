local rawRaycast = workspace.Raycast
local function clearPath(origin, head)
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    local exclude = {folder}
    if me.Character then table.insert(exclude,me.Character) end
    if workspace.CurrentCamera then table.insert(exclude,workspace.CurrentCamera) end
    p.FilterDescendantsInstances=exclude
    p.IgnoreWater=true
    local hit=rawRaycast(workspace,origin,head.Position-origin,p)
    return not hit or hit.Instance:IsDescendantOf(head.Parent)
end
local function clear(player)
    local e=tracked[player]
    if not e then return end
    for _,o in ipairs(e.objects) do o:Destroy() end
    tracked[player]=nil
end
local function setup(player,char)
    clear(player)
    local e={char=char,objects={},lines={}}
    tracked[player]=e
    local function keep(o) table.insert(e.objects,o); return o end
    e.highlight=keep(Instance.new('Highlight',folder))
    e.highlight.Adornee=char
    e.highlight.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    e.highlight.FillTransparency=0.85
    e.tag=keep(Instance.new('BillboardGui',gui))
    e.tag.Size=UDim2.fromOffset(270,48)
    e.tag.StudsOffset=Vector3.new(0,2.5,0)
    e.tag.AlwaysOnTop=true
    e.label=text(e.tag,'',0,48)
    e.label.TextStrokeTransparency=0
    return e
end
