local cameraActions = game:GetService('ContextActionService')
local freecamState
stopFreecam = function()
    if not freecamState then return end
    local saved = freecamState
    freecamState = nil
    cameraActions:UnbindAction('OX1DEFreecamMovement')
    UIS.MouseBehavior = saved.mouse
    UIS.MouseIconEnabled = saved.icon
    local camera = saved.camera
    if camera and camera.Parent then
        camera.CameraType = saved.cameraType
        if saved.subject and saved.subject.Parent then camera.CameraSubject = saved.subject end
        camera.CFrame = saved.cframe
        camera.Focus = saved.focus
    end
end
local function keyDown(key)
    return UIS:IsKeyDown(key) and 1 or 0
end
RunService:BindToRenderStep('OX1DEFreecam',Enum.RenderPriority.Last.Value+2,function(dt)
    local camera = workspace.CurrentCamera
    if not alive or not cfg.freecam or not camera then stopFreecam(); return end
    if freecamState and freecamState.camera ~= camera then stopFreecam() end
    if not freecamState then
        cameraActions:BindActionAtPriority('OX1DEFreecamMovement',function()
            return Enum.ContextActionResult.Sink
        end,false,Enum.ContextActionPriority.High.Value+10,
            Enum.PlayerActions.CharacterForward,Enum.PlayerActions.CharacterBackward,
            Enum.PlayerActions.CharacterLeft,Enum.PlayerActions.CharacterRight,
            Enum.PlayerActions.CharacterJump)
        me:Move(Vector3.new(0,0,0),false)
        local pitch,yaw = camera.CFrame:ToOrientation()
        freecamState = {
            camera=camera, cameraType=camera.CameraType,
            subject=camera.CameraSubject, cframe=camera.CFrame, focus=camera.Focus,
            mouse=UIS.MouseBehavior, icon=UIS.MouseIconEnabled,
            position=camera.CFrame.Position, pitch=pitch, yaw=yaw,
        }
    end
    local saved = freecamState
    camera.CameraType = Enum.CameraType.Scriptable
    local paused = panel.Visible or UIS:GetFocusedTextBox() ~= nil
    local rotating = not paused and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    UIS.MouseBehavior = rotating and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
    UIS.MouseIconEnabled = not rotating and saved.icon
    if rotating then
        local delta = UIS:GetMouseDelta()
        saved.yaw = saved.yaw - delta.X*0.003
        saved.pitch = math.clamp(saved.pitch-delta.Y*0.003, -math.pi/2+0.01, math.pi/2-0.01)
    end
    local rotation = CFrame.fromOrientation(saved.pitch,saved.yaw,0)
    if not paused then
        local movement = rotation.RightVector*(keyDown(Enum.KeyCode.D)-keyDown(Enum.KeyCode.A))
            +rotation.LookVector*(keyDown(Enum.KeyCode.W)-keyDown(Enum.KeyCode.S))
            +Vector3.new(0,keyDown(Enum.KeyCode.E)-keyDown(Enum.KeyCode.Q),0)
        if movement.Magnitude>1 then movement=movement.Unit end
        local fast = UIS:IsKeyDown(Enum.KeyCode.LeftShift)
        saved.position=saved.position+movement*cfg.cameraSpeed*(fast and 3 or 1)*math.min(dt,0.1)
    end
    camera.CFrame=CFrame.new(saved.position)*rotation
    camera.Focus=CFrame.new(saved.position+rotation.LookVector*20)
end)

