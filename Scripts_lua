-- Сохраняем обычный Raycast для собственных проверок.
local rawRaycast = workspace.Raycast

local function clearPath(origin, target)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local excluded = {folder}
    if me.Character then
        table.insert(excluded, me.Character)
    end
    if workspace.CurrentCamera then
        table.insert(excluded, workspace.CurrentCamera)
    end

    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = true

    local result = rawRaycast(
        workspace,
        origin,
        target.Position - origin,
        params
    )

    return result == nil
        or result.Instance:IsDescendantOf(target.Parent)
end

local function livingHead(player)
    local character = player.Character
    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")
    local head = character and character:FindFirstChild("Head")

    if humanoid and humanoid.Health > 0 and head then
        return head
    end
end

local function chooseTarget(origin, maxDistance)
    local camera = workspace.CurrentCamera
    if not camera then return end

    local center = camera.ViewportSize / 2
    local best
    local bestPixels = settings.fov

    for _, player in ipairs(Players:GetPlayers()) do
        if player == me then continue end

        local head = livingHead(player)
        if not head then continue end
        if (head.Position - origin).Magnitude > maxDistance then
            continue
        end

        local point, onScreen = camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local pixels = (
            Vector2.new(point.X, point.Y) - center
        ).Magnitude

        if pixels < bestPixels
            and (not settings.walls or clearPath(origin, head)) then
            best = head
            bestPixels = pixels
        end
    end

    return best
end

local function clearPlayer(player)
    local entry = tracked[player]
    if not entry then return end

    for _, object in ipairs(entry.objects) do
        object:Destroy()
    end

    tracked[player] = nil
end

local function setup(player, character)
    clearPlayer(player)

    local entry = {
        character = character,
        objects = {},
        lines = {},
    }
    tracked[player] = entry

    local function keep(object)
        table.insert(entry.objects, object)
        return object
    end

    local highlight = keep(Instance.new("Highlight"))
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.85
    highlight.Parent = folder
    entry.highlight = highlight

    local tag = keep(Instance.new("BillboardGui"))
    tag.Size = UDim2.fromOffset(240, 30)
    tag.StudsOffset = Vector3.new(0, 2.5, 0)
    tag.AlwaysOnTop = true
    tag.Parent = gui
    entry.tag = tag

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = player.DisplayName .. " (@" .. player.Name .. ")"
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = tag
    entry.label = label
end

connect(Players.PlayerRemoving, clearPlayer)

connect(RunService.RenderStepped, function()
    local camera = workspace.CurrentCamera
    if not camera then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == me then continue end

        local character = player.Character
        if not character then
            clearPlayer(player)
            continue
        end

        local entry = tracked[player]
        if not entry or entry.character ~= character then
            setup(player, character)
            entry = tracked[player]
        end

        local head = livingHead(player)
        local visible = head
            and clearPath(camera.CFrame.Position, head)

        local color = visible
            and Color3.fromRGB(60, 255, 100)
            or Color3.fromRGB(255, 65, 65)

        entry.highlight.Enabled = settings.esp and head ~= nil
        entry.highlight.FillColor = color
        entry.highlight.OutlineColor = color

        entry.tag.Adornee = head
        entry.tag.Enabled = settings.esp
            and settings.names and head ~= nil
        entry.label.TextColor3 = color

        for _, joint in ipairs(character:GetDescendants()) do
            if not joint:IsA("Motor6D") then continue end
            local a, b = joint.Part0, joint.Part1
            if not a or not b then continue end
            if a.Name == "HumanoidRootPart"
                or b.Name == "HumanoidRootPart" then
                continue
            end

            local line = entry.lines[joint]
            if not line then
                line = Instance.new("LineHandleAdornment")
                line.Adornee = workspace.Terrain
                line.AlwaysOnTop = true
                line.ZIndex = 5
                line.Thickness = 2
                line.Parent = folder
                entry.lines[joint] = line
                table.insert(entry.objects, line)
            end

            local length = (b.Position - a.Position).Magnitude
            line.Color3 = color
            line.Visible = settings.esp
                and settings.skeleton
                and head ~= nil
                and length > 0.01

            if length > 0.01 then
                line.Length = length
                line.CFrame = CFrame.lookAt(a.Position, b.Position)
            end
        end

        for joint, line in pairs(entry.lines) do
            if not joint:IsDescendantOf(character)
                or not joint.Part0 or not joint.Part1 then
                line:Destroy()
                entry.lines[joint] = nil
            end
        end
    end
end)

-- Экспериментальный перехват Raycast.
-- Не влияет на серверные выстрелы или другие системы оружия.
local hookInstalled = false

if type(hookmetamethod) == "function"
    and type(getnamecallmethod) == "function"
    and type(checkcaller) == "function" then

    local previous
    local callback = function(self, ...)
        local args = table.pack(...)

        if alive
            and settings.silent
            and self == workspace
            and not checkcaller()
            and getnamecallmethod() == "Raycast"
            and typeof(args[1]) == "Vector3"
            and typeof(args[2]) == "Vector3" then

            local origin = args[1]
            local length = args[2].Magnitude

            if length > 0 then
                local ok, target = pcall(chooseTarget, origin, length)

                if ok and target then
                    local direction = target.Position - origin
                    if direction.Magnitude > 0.001 then
                        args[2] = direction.Unit * length
                    end
                end
            end
        end

        return previous(self, table.unpack(args, 1, args.n))
    end

    local ok = pcall(function()
        previous = hookmetamethod(
            game,
            "__namecall",
            type(newcclosure) == "function"
                and newcclosure(callback)
                or callback
        )
    end)

    hookInstalled = ok
end

if hookInstalled then
    status.Text = "Правый Shift — меню • Радиус: 150 px\n"
        .. "Raycast-перехват установлен; попадания не проверены"
else
    status.Text = "Правый Shift — меню\n"
        .. "Silent aim недоступен: нет поддержки перехвата"
end

_G.BriskToolsStop = function()
    alive = false
    settings.silent = false

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    for player in pairs(tracked) do
        clearPlayer(player)
    end

    folder:Destroy()
    gui:Destroy()
    _G.BriskToolsStop = nil
end
