-- Ordinary camera aim. No metamethod hooks and no automatic firing.
local function interceptTime(relative, velocity, speed)
    if speed <= 0 then return 0 end
    local a = velocity:Dot(velocity) - speed*speed
    local b = 2*relative:Dot(velocity)
    local c = relative:Dot(relative)
    if math.abs(a) < 0.000001 then
        if math.abs(b) < 0.000001 then return nil end
        local t = -c/b
        return t > 0 and t or nil
    end
    local discriminant = b*b - 4*a*c
    if discriminant < 0 then return nil end
    local root = math.sqrt(discriminant)
    local t1, t2 = (-b-root)/(2*a), (-b+root)/(2*a)
    if t1 > 0 and t2 > 0 then return math.min(t1,t2) end
    if t1 > 0 then return t1 end
    if t2 > 0 then return t2 end
end
local function chooseHead(camera)
    local center = camera.ViewportSize/2
    local ownRoot = me.Character and me.Character:FindFirstChild('HumanoidRootPart')
    local origin = ownRoot and ownRoot.Position or camera.CFrame.Position
    local candidatesForAim = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player == me then continue end
        local char = player.Character
        local head = char and char:FindFirstChild('Head')
        local hum = char and char:FindFirstChildOfClass('Humanoid')
        if not head or not hum or hum.Health <= 0 then continue end
        local root = char:FindFirstChild('HumanoidRootPart') or head
        local distance = (root.Position-origin).Magnitude*0.28
        if distance > math.min(cfg.aimDistance, cfg.distance) then continue end
        local point, onScreen = camera:WorldToViewportPoint(head.Position)
        local pixels = (Vector2.new(point.X,point.Y)-center).Magnitude
        if onScreen and pixels <= cfg.fov then
            table.insert(candidatesForAim,{head=head,pixels=pixels})
        end
    end
    table.sort(candidatesForAim,function(a,b) return a.pixels < b.pixels end)
    for _, candidate in ipairs(candidatesForAim) do
        if not cfg.walls or clearPath(camera.CFrame.Position,candidate.head) then return candidate.head end
    end
end
