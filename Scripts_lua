connect(RunService.RenderStepped,function()
    local camera=workspace.CurrentCamera
    if not camera then return end
    local root=me.Character and me.Character:FindFirstChild('HumanoidRootPart')
    local origin=root and root.Position or camera.CFrame.Position
    for _,player in ipairs(Players:GetPlayers()) do
        if player==me then continue end
        local char=player.Character
        if not char then clear(player); continue end
        local e=tracked[player]
        if not e or e.char~=char then e=setup(player,char) end
        local head=char:FindFirstChild('Head')
        local hum=char:FindFirstChildOfClass('Humanoid')
        local target=char:FindFirstChild('HumanoidRootPart') or head
        local meters=target and (target.Position-origin).Magnitude*0.28 or math.huge
        local show=cfg.esp and head~=nil and hum~=nil and hum.Health>0 and meters<=cfg.distance
        local visible=show and clearPath(camera.CFrame.Position,head)
        local color=visible and Color3.fromRGB(60,255,100) or Color3.fromRGB(255,65,65)
        e.highlight.Enabled=show
        e.highlight.FillColor=color
        e.highlight.OutlineColor=color
        e.tag.Adornee=head
        e.tag.Enabled=show and cfg.names
        e.label.TextColor3=color
        if target and hum then
            e.label.Text=string.format('%s (@%s)\nHP: %d / %d | %d m',player.DisplayName,player.Name,math.ceil(hum.Health),math.ceil(hum.MaxHealth),math.round(meters))
        end
        if show and cfg.skeleton then
            for _,joint in ipairs(char:GetDescendants()) do
                if not joint:IsA('Motor6D') then continue end
                local a,b=joint.Part0,joint.Part1
                if not a or not b or a.Name=='HumanoidRootPart' or b.Name=='HumanoidRootPart' then continue end
                if not e.lines[joint] then
                    local line=Instance.new('LineHandleAdornment',folder)
                    line.Adornee=workspace.Terrain
                    line.AlwaysOnTop=true
                    line.ZIndex=5
                    line.Thickness=2
                    e.lines[joint]=line
                    table.insert(e.objects,line)
                end
            end
        end
        for joint,line in pairs(e.lines) do
            local a,b=joint.Part0,joint.Part1
            if not joint:IsDescendantOf(char) or not a or not b then
                line:Destroy(); e.lines[joint]=nil
            else
                local length=(b.Position-a.Position).Magnitude
                line.Visible=show and cfg.skeleton and length>0.01
                line.Color3=color
                if line.Visible then line.Length=length; line.CFrame=CFrame.lookAt(a.Position,b.Position) end
            end
        end
    end
end)
local function chooseTarget(origin,maxDistance,rayParams)
    local camera=workspace.CurrentCamera
    if not camera or not cfg.esp then return end
    local root=me.Character and me.Character:FindFirstChild('HumanoidRootPart')
    local playerOrigin=root and root.Position or camera.CFrame.Position
    local best,limit=nil,cfg.fov
    local center=camera.ViewportSize/2
    for _,player in ipairs(Players:GetPlayers()) do
        if player==me then continue end
        local char=player.Character
        local head=char and char:FindFirstChild('Head')
        local hum=char and char:FindFirstChildOfClass('Humanoid')
        if not head or not hum or hum.Health<=0 then continue end
        local delta=head.Position-origin
        if delta.Magnitude>maxDistance or delta.Magnitude<0.001 then continue end
        local distancePart=char:FindFirstChild('HumanoidRootPart') or head
        local meters=(distancePart.Position-playerOrigin).Magnitude*0.28
        if meters>cfg.aimDistance or meters>cfg.distance then continue end
        -- Same camera visibility test used to color ESP green.
        if not clearPath(camera.CFrame.Position,head) then continue end
        local point,onScreen=camera:WorldToViewportPoint(head.Position)
        local pixels=(Vector2.new(point.X,point.Y)-center).Magnitude
        if not onScreen or pixels>=limit then continue end
        if cfg.walls then
            if not clearPath(origin,head) then continue end
            -- Also honor the original ray's collision/filter settings.
            local hit=rawRaycast(workspace,origin,delta.Unit*(delta.Magnitude+0.1),rayParams)
            if hit and not hit.Instance:IsDescendantOf(char) then continue end
        end
        best,limit=head,pixels
    end
    return best
end
local installed=false
if type(hookmetamethod)=='function' and type(getnamecallmethod)=='function' and type(checkcaller)=='function' then
    local previous
    local callback=function(self,...)
        local args=table.pack(...)
        if alive and cfg.aim and self==workspace and not checkcaller() and getnamecallmethod()=='Raycast'
            and typeof(args[1])=='Vector3' and typeof(args[2])=='Vector3' then
            local length=args[2].Magnitude
            local ok,head=pcall(chooseTarget,args[1],length,args[3])
            if ok and head then
                local delta=head.Position-args[1]
                if delta.Magnitude>0.001 then args[2]=delta.Unit*length end
            end
        end
        return previous(self,table.unpack(args,1,args.n))
    end
    installed=pcall(function()
        previous=hookmetamethod(game,'__namecall',type(newcclosure)=='function' and newcclosure(callback) or callback)
    end)
end
status.Text=installed and 'Raycast hook installed. Game compatibility unverified.' or 'Raycast hook unavailable. ESP still works.'
_G.BriskToolsStop=function()
    alive=false
    cfg.aim=false
    for _,c in ipairs(connections) do c:Disconnect() end
    for player in pairs(tracked) do clear(player) end
    folder:Destroy()
    gui:Destroy()
    _G.BriskToolsStop=nil
end
