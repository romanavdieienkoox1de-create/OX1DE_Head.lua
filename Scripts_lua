local selectedHead, nextSelection = nil, 0
local function aimStatus(message)
    if status.Text ~= message then status.Text = message end
end
RunService:BindToRenderStep('OX1DECameraAim',Enum.RenderPriority.Last.Value+1,function()
    local camera = workspace.CurrentCamera
    local holding = touchHeld or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if not alive or not cfg.aim or (cfg.holdAim and not holding) or panel.Visible or UIS:GetFocusedTextBox() or not camera then
        if not cfg.aim then aimStatus('Аим выключен.')
        elseif panel.Visible then aimStatus('Аим включён. Закрой меню: Right Shift или ×.')
        elseif cfg.holdAim and not holding then aimStatus('Удерживай ПКМ или кнопку HOLD AIM.')
        else aimStatus('Наведение приостановлено.') end
        selectedHead=nil
        nextSelection=0
        return
    end
    local now = os.clock()
    if now >= nextSelection then
        selectedHead=chooseHead(camera)
        nextSelection=now+0.05
    end
    local head=selectedHead
    if not head or not head:IsDescendantOf(workspace) then
        aimStatus('Нет цели: голова должна быть в FOV, в пределах дальности и без стены.')
        return
    end
    local hum=head.Parent:FindFirstChildOfClass('Humanoid')
    if not hum or hum.Health<=0 then selectedHead=nil; return end
    local origin=camera.CFrame.Position
    local point = head.Position
    if cfg.predict then
        local velocity=head.AssemblyLinearVelocity
        local delay=cfg.leadMs/1000
        local relative=head.Position+velocity*delay-origin
        local flight=interceptTime(relative,velocity,cfg.bulletSpeed)
        if flight == nil or flight > 3 then
            aimStatus('Нет решения упреждения: проверь скорость пули.')
            return
        end
        point=head.Position+velocity*(delay+flight)
            +Vector3.new(0,0.5*cfg.bulletGravity*flight*flight,0)
    end
    if (point-origin).Magnitude<0.001 then return end
    if cfg.predict and cfg.walls then
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        local excluded={folder,camera,head.Parent}
        if me.Character then table.insert(excluded,me.Character) end
        params.FilterDescendantsInstances=excluded
        params.IgnoreWater=true
        if rawRaycast(workspace,origin,point-origin,params) then
            aimStatus('Точка упреждения закрыта препятствием.')
            return
        end
    end
    camera.CFrame=CFrame.lookAt(origin,point)
    aimStatus((cfg.predict and 'С упреждением: ' or 'На голове: ') .. head.Parent.Name)
end)
updateCircle()
