-- Resource detection is heuristic; no game-specific object names are known.
local CollectionService = game:GetService('CollectionService')
local resourceKinds = {
    buildings = {title='Постройка', color=Color3.fromRGB(220,220,220)},
    cupboard = {title='Шкаф', color=Color3.fromRGB(197, 130, 255)},
    stone = {title='Камень', color=Color3.fromRGB(200, 205, 218)},
    nitrate = {title='Сера', color=Color3.fromRGB(255, 255, 255)},
    metal = {title='Металл', color=Color3.fromRGB(255, 216, 70)},
}
local aliases = {
    stone={'stone','stoneore','stonenode','rock','rocknode','камень'},
    nitrate={'nitrate','nitrateore','nitratenode','saltpeter','saltpetre','селитра'},
    metal={'metal','metalore','metalnode','iron','ironore','металл','метал'},
}
local function identifyName(value)
    if type(value) ~= 'string' then return end
    local normalized = value:gsub('(%l)(%u)', '%1 %2'):lower()
    for kind, words in pairs(aliases) do
        for _, word in ipairs(words) do
            if normalized == word then return kind end
            for token in normalized:gmatch('[^%s_%-%d%.]+') do
                if token == word then return kind end
            end
        end
    end
end
local function identifyResource(object)
    if object.Name == 'Flag' and object.Parent
        and object.Parent.Name == 'PlacedDeployables' then return 'cupboard' end
    local container=object.Parent and object.Parent.Name
    if container=='PlacedDeployables' or container=='PlacedBuildings' or container=='PlacedStructures' then
        local name=object.Name:gsub('(%l)(%u)','%1 %2'):lower()
        local buildingNames={wall=true,foundation=true,floor=true,roof=true,ceiling=true,door=true,doorway=true,window=true,stairs=true,house=true}
        for token in name:gmatch('[^%s_%-%d%.]+') do
            if buildingNames[token] then return 'buildings' end
        end
    end
    -- Typed metadata takes precedence over a generic model name.
    for _, key in ipairs({'ResourceType','OreType','Resource','NodeType'}) do
        local kind = identifyName(object:GetAttribute(key))
        if kind then return kind end
    end
    for _, tag in ipairs(CollectionService:GetTags(object)) do
        local kind = identifyName(tag)
        if kind and not (kind == 'stone' and tag:lower() == 'rock') then return kind end
    end
    local kind = identifyName(object.Name)
    if kind ~= 'stone' then return kind end
    -- A generic Rock/Stone name also occurs on decorative scenery.
    local name = object.Name:gsub('(%l)(%u)', '%1 %2'):lower()
    if name:find('ore', 1, true) or name:find('node', 1, true)
        or name:find('resource', 1, true) then
        return kind
    end
    local ancestor = object.Parent
    for _ = 1, 4 do
        if not ancestor or ancestor == workspace then break end
        local category = ancestor.Name:lower()
        if category == 'resources' or category == 'resource nodes'
            or category == 'resourcenodes' or category == 'ores'
            or category == 'orenodes' or category == 'harvestables'
            or category == 'spawnedharvestables' then
            return kind
        end
        ancestor = ancestor.Parent
    end
    return nil
end
